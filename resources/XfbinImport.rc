// ============================================================
//  XfbinImport.rc - Fenster und eingebettetes MacroScript
//
//  Die beiden Fenster (Aufbau wie beim Dragon Ball Legends und
//  Bleach Import). Masse in Dialogeinheiten (DLU), damit alles
//  mit Schrift und Anzeigeskalierung mitwaechst. Abstaende nach
//  Microsofts Layoutregeln: Rand 7, verwandte Elemente 4,
//  unverwandte 7. Nur ASCII - rc.exe liest es dann sicher.
//
//  Die .mcr liegt zusaetzlich als RCDATA in der DLU und wird beim
//  Start registriert, falls keine installierte Fassung da ist -
//  Skript und Plugin sind so per Konstruktion derselbe Stand.
// ============================================================
#include <windows.h>
#include "../src/xfbinimport_res.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

XFBIN_MCR_RESOURCE  RCDATA  "../scripts/XfbinImport.mcr"

IDD_FIGUREN DIALOGEX 0, 0, 440, 306
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Ninja Storm Importer"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "Game", IDC_SPIEL_LABEL, 7, 10, 24, 8
    COMBOBOX        IDC_SPIEL, 34, 7, 336, 200, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP | WS_GROUP
    PUSHBUTTON      "Browse...", IDC_DURCHSUCHEN, 376, 6, 57, 15, BS_OWNERDRAW | WS_TABSTOP
    LTEXT           "", IDC_ORDNER, 34, 24, 399, 8, SS_PATHELLIPSIS | SS_NOPREFIX
    CONTROL         "", IDC_STATUS, "Static", SS_OWNERDRAW, 7, 36, 426, 16

    PUSHBUTTON      "Characters", IDC_TAB0, 7, 58, 66, 15, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "Others", IDC_TAB1, 77, 58, 58, 15, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "All", IDC_TAB2, 139, 58, 46, 15, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "Textures", IDC_TEXTUREN, 193, 58, 58, 15, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "Effects", IDC_EFFEKTE, 255, 58, 56, 15, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "Reactions", IDC_REAKTIONEN, 315, 58, 58, 15, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "Clear scene", IDC_LEEREN, 377, 58, 56, 15, BS_OWNERDRAW | WS_TABSTOP

    LTEXT           "Search", IDC_SUCHE_LABEL, 7, 81, 30, 8
    EDITTEXT        IDC_SUCHE, 40, 78, 218, 14, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER
    RTEXT           "", IDC_ANZAHL, 262, 81, 108, 8
    PUSHBUTTON      "WC3 mode", IDC_WC3, 377, 77, 56, 15, BS_OWNERDRAW | WS_TABSTOP

    LISTBOX         IDC_LISTE, 7, 97, 426, 157, LBS_OWNERDRAWFIXED | LBS_NODATA | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | NOT WS_BORDER
    LTEXT           "", IDC_DETAIL, 7, 258, 426, 8, SS_NOPREFIX | SS_ENDELLIPSIS

    LTEXT           "", IDC_FUSS, 7, 287, 166, 8, SS_NOPREFIX | SS_ENDELLIPSIS
    PUSHBUTTON      "Animations...", IDC_ANIMFENSTER, 241, 283, 68, 16, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "Import", IDOK, 313, 283, 58, 16, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "Close", IDCANCEL, 375, 283, 58, 16, BS_OWNERDRAW | WS_TABSTOP
END

IDD_ANIMATIONEN DIALOGEX 0, 0, 440, 320
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "Ninja Storm Animations"
FONT 9, "Segoe UI", 400, 0, 0x0
BEGIN
    LTEXT           "Character", -1, 8, 10, 38, 10
    LTEXT           "", IDC_A_FIGUR, 48, 10, 384, 10, SS_NOPREFIX | SS_ENDELLIPSIS
    LTEXT           "Group", -1, 8, 27, 24, 10
    COMBOBOX        IDC_A_ZEIGE, 34, 25, 120, 220, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Search", -1, 164, 27, 26, 10
    EDITTEXT        IDC_A_SUCHE, 192, 26, 240, 11, ES_AUTOHSCROLL | WS_TABSTOP | NOT WS_BORDER
    CONTROL         "", IDC_A_KOPF, "Static", SS_OWNERDRAW, 8, 44, 424, 12
    LISTBOX         IDC_A_LISTE, 8, 57, 424, 176, LBS_OWNERDRAWFIXED | LBS_NODATA | LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP | NOT WS_BORDER
    CONTROL         "", IDC_A_STATUS, "Static", SS_OWNERDRAW, 8, 238, 424, 16
    LTEXT           "Sequence", -1, 8, 262, 36, 10
    COMBOBOX        IDC_A_SEQUENZ, 46, 260, 386, 220, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "WC3 mode", IDC_A_WC3, 8, 279, 62, 15, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "Note track", IDC_A_NOTIZ, 74, 279, 56, 15, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "Rest keys", IDC_A_RUHE, 134, 279, 52, 15, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "Visibility", IDC_A_SICHT, 190, 279, 54, 15, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "Material", IDC_A_MATERIAL, 248, 279, 50, 15, BS_OWNERDRAW | WS_TABSTOP
    LTEXT           "Gap", -1, 8, 301, 18, 10
    EDITTEXT        IDC_A_ABSTAND, 28, 300, 22, 11, ES_NUMBER | NOT WS_BORDER
    LTEXT           "frames", -1, 54, 301, 26, 10
    PUSHBUTTON      "All to timeline", IDC_A_ALLE, 240, 298, 68, 15, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "Load", IDC_A_LADEN, 312, 298, 58, 15, BS_OWNERDRAW | WS_TABSTOP
    PUSHBUTTON      "Close", IDCANCEL, 374, 298, 58, 15, BS_OWNERDRAW | WS_TABSTOP
END
