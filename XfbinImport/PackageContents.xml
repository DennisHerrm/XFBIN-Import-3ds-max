<?xml version="1.0" encoding="utf-8"?>
<ApplicationPackage
    SchemaVersion="1.9.4"
    AutodeskProduct="3ds Max"
    ProductType="Application"
    Name="XfbinImport"
    Description="CyberConnect2 XFBIN Importer"
    AppVersion="1.9.4"
    FriendlyVersion="1.9.4"
    Author="DH"
    UpgradeCode="{B4E1C77A-2D93-4F60-9A15-3E6C81D4F2A7}"
    ProductCode="{FB64EBF3-A65C-4403-B8FD-E9B6D0C8FEE8}">

    <!-- UpgradeCode ist die dauerhafte Kennung des Pakets und darf sich
         NIE aendern - Max laedt nur ein Paket je UpgradeCode.
         ProductCode dagegen laut Autodesk-Doku bei jeder Aenderung von
         AppVersion neu vergeben. Beim naechsten Versionssprung also
         AppVersion, FriendlyVersion, alle Version="1.9.4" UND ProductCode
         anfassen; UpgradeCode stehen lassen. -->

    <CompanyDetails Name="DH" />

    <RuntimeRequirements OS="Win64" Platform="3ds Max" SeriesMin="2016" SeriesMax="2027" />

    <!-- ========================================================
         1. Das Plugin selbst.
         Pro Max-Version ein eigener Block, weil jede Version
         gegen ihr eigenes SDK gebaut ist. Eine DLU aus 2024 in
         2026 zu laden endet im Absturz, nicht in einer Meldung.

         Nicht installierte Versionen fehlen im output-Ordner;
         INSTALLIERE.bat ueberspringt sie dann einfach.
         ======================================================== -->

    <Components Description="plugins parts">
        <RuntimeRequirements OS="Win64" Platform="3ds Max" SeriesMin="2016" SeriesMax="2016" />
        <ComponentEntry AppName="XfbinImport" Version="1.9.4"
                        ModuleName="./Contents/2016/XfbinImport.dlu"
                        AppDescription="XFBIN Container Reader" />
    </Components>

    <Components Description="plugins parts">
        <RuntimeRequirements OS="Win64" Platform="3ds Max" SeriesMin="2017" SeriesMax="2017" />
