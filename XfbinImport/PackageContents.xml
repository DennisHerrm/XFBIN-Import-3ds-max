    <!-- ========================================================
         2. MacroScript - die Oberflaeche.
         Landet unter Customize -> Customize User Interface ->
         Category "DH Tools" und laesst sich von dort auch auf
         eine Toolbar oder einen Shortcut legen.
         ======================================================== -->

    <Components Description="macroscripts parts">
        <RuntimeRequirements OS="Win64" Platform="3ds Max" SeriesMin="2016" SeriesMax="2027" />
        <ComponentEntry AppName="XfbinImportUI" Version="1.9.4"
                        ModuleName="./Contents/MacroScripts/XfbinImport.mcr"
                        AppDescription="Oberflaeche fuer XFBIN Import" />
    </Components>

    <!-- ========================================================
         3. Menueeintrag.
         ACHTUNG: 3ds Max 2025 hat das Menuesystem umgebaut. Das
         alte menuMan-API ist dort abgeloest, Menues werden ueber
         den Callback #cuiRegisterMenus registriert. Deshalb zwei
         getrennte Skripte mit sich NICHT ueberschneidenden
         Versionsbereichen - laeuft beides, entsteht das Menue
         doppelt.

         "post-start-up" und nicht "pre-start-up": zu diesem
         Zeitpunkt steht die Oberflaeche, vorher gibt es noch
         keine Menueleiste.
         ======================================================== -->

    <Components Description="post-start-up scripts parts">
        <RuntimeRequirements OS="Win64" Platform="3ds Max" SeriesMin="2016" SeriesMax="2024" />
        <ComponentEntry AppName="XfbinImportMenuLegacy" Version="1.9.4"
                        ModuleName="./Contents/Post-Start-Up_Scripts/XfbinMenu_2016_2024.ms"
                        AppDescription="Menueeintrag (menuMan, bis 2024)" />
    </Components>

    <Components Description="post-start-up scripts parts">
        <RuntimeRequirements OS="Win64" Platform="3ds Max" SeriesMin="2025" SeriesMax="2027" />
        <ComponentEntry AppName="XfbinImportMenu" Version="1.9.4"
                        ModuleName="./Contents/Post-Start-Up_Scripts/XfbinMenu_2025_2027.ms"
                        AppDescription="Menueeintrag (CuiMenuManager, ab 2025)" />
    </Components>

</ApplicationPackage>
